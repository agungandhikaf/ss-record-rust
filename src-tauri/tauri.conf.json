{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devPath": "http://127.0.0.1:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "MyTBC",
    "version": "1.0.17"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "Internal tool",
      "identifier": "com.temanakun.mytbc",
      "targets": "all",
      "shortDescription": "Manual screenshot recorder for Tester Budak Corporate",
      "longDescription": "MyTBC adalah aplikasi desktop ringan berbasis Tauri + Rust untuk membantu Tester Budak Corporate menyimpan evidence screenshot manual per folder TC001, TC002, dan seterusnya.",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "MyTBC",
        "width": 980,
        "height": 860,
        "minWidth": 680,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
